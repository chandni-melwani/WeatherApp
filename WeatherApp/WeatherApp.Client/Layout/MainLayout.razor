@inherits LayoutComponentBase
@using WeatherApp.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject FavoritesService FavoritesService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<MudThemeProvider Theme="_myTheme" @bind-IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary">
        <MudText Typo="Typo.h6" Style="color:white;">
            🌤 Weather App
        </MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.End"
                       OnClick="ToggleDrawer"
                       Style="color:white;" />
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen"
               Anchor="Anchor.End"
               Elevation="2"
               Variant="DrawerVariant.Temporary"
               Width="320px">

        <MudDrawerHeader Style="padding: 24px;">
            <MudText Typo="Typo.h4" Style="font-weight:700;">Menu</MudText>
        </MudDrawerHeader>

        <MudNavMenu>
            @if (AuthService.IsLoggedIn())
            {
                <div class="px-4 py-2">
                    <MudText Typo="Typo.caption" Style="color:gray;">Logged in as</MudText>
                    <MudText Typo="Typo.body2" Style="word-break:break-all;">
                        @AuthService.GetCurrentUserEmail()
                    </MudText>
                </div>

                <MudDivider Class="my-2" />

                <div class="px-4 py-2">
                    <MudText Typo="Typo.caption" Style="color:gray;">Favorite Weather</MudText>
                    <div class="mt-2 d-flex flex-wrap gap-2">
                        @foreach (var condition in new[] { "Clear", "Clouds", "Rain", "Thunderstorm", "Snow", "Mist" })
                        {
                            <MudChip T="string"
                                     Color="@(favoriteWeather == condition ? Color.Primary : Color.Default)"
                                     Variant="@(favoriteWeather == condition ? Variant.Filled : Variant.Outlined)"
                                     OnClick="() => SaveFavoriteWeather(condition)"
                                     Size="Size.Small">
                                @WeatherHelper.GetWeatherIcon(condition) @condition
                            </MudChip>
                        }
                    </div>
                </div>

                <MudDivider Class="my-2" />

                <MudNavLink Icon="@Icons.Material.Filled.Logout"
                            OnClick="HandleLogout">
                    Logout
                </MudNavLink>
            }
            else
            {
                <MudNavLink Icon="@Icons.Material.Filled.Login"
                            OnClick='() => Navigation.NavigateTo("/login")'
                            Style="font-size:1.1rem;">
                    Login
                </MudNavLink>
            }

            <MudDivider Class="my-2" />

            <div class="px-4 py-4 d-flex align-center justify-space-between">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@(isDarkMode ? Icons.Material.Filled.WbSunny : Icons.Material.Filled.DarkMode)"
                             Size="Size.Medium" />
                    <MudText Typo="Typo.body1" Style="font-size:1.2rem;">
                        @(isDarkMode ? "Light Mode" : "Dark Mode")
                    </MudText>
                </div>
                <MudSwitch T="bool"
                           Value="isDarkMode"
                           ValueChanged="OnDarkModeChanged"
                           Color="Color.Primary" />
            </div>

        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <CascadingValue Value="this">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    bool isDarkMode = false;
    bool drawerOpen = false;
    string favoriteWeather = "";
    public bool IsDarkMode => isDarkMode;

    MudTheme _myTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1565C0",
            Secondary = "#FF8F00",
            AppbarBackground = "#0D47A1",
            Background = "#F0F4F8",
            Surface = "#FFFFFF",
            TextPrimary = "#1A237E",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#1565C0",
            Secondary = "#FF8F00",

            AppbarBackground = "#0D47A1",

            Background = "#1a1a2e",
            Surface = "#16213e",

            TextPrimary = "#FFFFFF",
            TextSecondary = "#E0E0E0",

            DrawerBackground = "#16213e",
            DrawerText = "#FFFFFF",

            ActionDefault = "#FFFFFF",
            ActionDisabled = "#BDBDBD"
        }
    };

    async Task ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
        if (drawerOpen && AuthService.IsLoggedIn())
        {
            favoriteWeather = await FavoritesService.GetFavoriteWeather() ?? "";
        }
    }

    public async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await LocalStorage.SetItemAsync("darkMode", isDarkMode);
        StateHasChanged();
    }

    async Task SaveFavoriteWeather(string condition)
    {
        favoriteWeather = condition;
        await FavoritesService.SaveFavoriteWeather(condition);
        Snackbar.Add($"Favorite weather set to {condition}!", Severity.Success);
    }

    public event Action? OnLogout;

    async Task HandleLogout()
    {
        await AuthService.SignOut();
        drawerOpen = false;
        favoriteWeather = "";
        Snackbar.Add("Logged out successfully!", Severity.Info);
        OnLogout?.Invoke();
        Navigation.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDarkMode = await LocalStorage.GetItemAsync<bool>("darkMode");
            StateHasChanged();
        }
    }

    async Task OnDarkModeChanged(bool val)
    {
        isDarkMode = val;
        await LocalStorage.SetItemAsync("darkMode", val);
        StateHasChanged();
    }
}