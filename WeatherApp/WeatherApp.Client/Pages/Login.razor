@page "/login"
@using WeatherApp.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Style="padding-top:60px; padding-bottom:40px;">
    <MudPaper Elevation="8" Class="rounded-xl overflow-hidden" Style="border-radius:20px; width:100%;">
        <div Style="background: @GetHeaderGradient(); padding: 40px 32px; text-align:center; transition: background 1s ease;">
            <MudText Style="font-size:48px;">
                @(isSignUp ? "📝" : GetTimeEmoji())
            </MudText>
            <MudText Typo="Typo.h5" Style="color:white; font-weight:700; margin-top:8px;">
                @(isSignUp ? "Create Account" : GetGreeting())
            </MudText>
            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.8);">
                @(isSignUp ? "Join to save your favourite cities" : GetSubtitle())
            </MudText>
        </div>

        <div class="pa-6">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    @successMessage
                </MudAlert>
            }

            <MudTextField Label="Email"
                          @bind-Value="email"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Class="mb-4"
                          FullWidth="true" />

            <MudTextField Label="Password"
                          @bind-Value="password"
                          Variant="Variant.Outlined"
                          InputType="@(showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => showPassword = !showPassword"
                          Class="mb-6"
                          FullWidth="true" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="HandleSubmit"
                       Disabled="isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    @(isSignUp ? "Create Account" : "Sign In")
                }
            </MudButton>

            <MudDivider Class="my-4" />

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="ToggleMode">
                @(isSignUp ? "Already have an account? Sign In" : "No account? Sign Up")
            </MudButton>

            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       FullWidth="true"
                       Class="mt-2"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick='() => Navigation.NavigateTo("/")'>
                Back to Home
            </MudButton>

        </div>
    </MudPaper>
</MudContainer>

@code {

    string email = "";
    string password = "";
    string errorMessage = "";
    string successMessage = "";
    bool isLoading = false;
    bool isSignUp = false;
    bool showPassword = false;

    void ToggleMode()
    {
        isSignUp = !isSignUp;
        errorMessage = "";
        successMessage = "";
        email = "";
        password = "";
    }

    async Task HandleSubmit()
    {
        try
        {
            isLoading = true;
            errorMessage = "";
            successMessage = "";

            if (isSignUp)
            {
                bool success = await AuthService.SignUp(email, password);
                if (success)
                {
                    // Clear the form for safety
                    email = "";
                    password = "";
                    // Switch to sign in mode automatically
                    isSignUp = false;
                    successMessage = "Account created! Please sign in.";
                }
                else
                    errorMessage = "Signup failed. Try again.";
            }
            else
            {
                bool success = await AuthService.SignIn(email, password);
                if (success)
                {
                    Snackbar.Add($"Welcome back!", Severity.Success);
                    Navigation.NavigateTo("/");
                }
                else
                    errorMessage = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            // Extract clean message from Supabase error
            if (ex.Message.Contains("Invalid login credentials") ||
                ex.Message.Contains("validation_failed"))
                errorMessage = "Invalid email or password.";
            else if (ex.Message.Contains("weak_password"))
                errorMessage = "Password must be at least 6 characters.";
            else
                errorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        return hour switch
        {
            >= 5 and < 12 => "Good Morning!",
            >= 12 and < 17 => "Good Afternoon!",
            >= 17 and < 20 => "Good Evening!",
            _ => "Good Night!"
        };
    }

    string GetSubtitle()
    {
        var hour = DateTime.Now.Hour;
        return hour switch
        {
            >= 5 and < 12 => "Start your day with the weather",
            >= 12 and < 17 => "Check the afternoon forecast",
            >= 17 and < 20 => "Plan your evening ahead",
            _ => "Check tomorrow's weather"
        };
    }

    string GetTimeEmoji()
    {
        var hour = DateTime.Now.Hour;
        return hour switch
        {
            >= 5 and < 12 => "🌅",
            >= 12 and < 17 => "☀️",
            >= 17 and < 20 => "🌆",
            _ => "🌙"
        };
    }

    string GetHeaderGradient()
    {
        var hour = DateTime.Now.Hour;
        return hour switch
        {
            >= 5 and < 12 => "linear-gradient(135deg, #1565C0, #42A5F5)",
            >= 12 and < 17 => "linear-gradient(135deg, #0277BD, #0288D1)",
            >= 17 and < 20 => "linear-gradient(135deg, #1565C0, #5C6BC0)",
            _ => "linear-gradient(135deg, #0D47A1, #1A237E)"
        };
    }

}