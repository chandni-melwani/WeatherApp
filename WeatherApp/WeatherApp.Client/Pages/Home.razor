@page "/"
@implements IDisposable
@using WeatherApp.Client.Models
@using WeatherApp.Client.Services
@inject AuthService AuthService
@inject FavoritesService FavoritesService
@inject WeatherService WeatherService
@inject ISnackbar Snackbar

<div style="min-height:100vh; transition: background 1s ease; background: @GetPageBackground();">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="pt-6 pb-6">
        <MudPaper Elevation="0"
                  Class="pa-6"
                  Style="background:transparent;">

            @if (weather == null && !isLoading)
            {
                <div class="text-center py-6">
                    <MudText Style="font-size:72px; line-height:1;">🌤</MudText>
                    <MudText Typo="Typo.h4" Class="mt-3" Style="font-weight:700;">
                        Weather App
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mt-2" Style="color:#546E7A;">
                        Enter a place name below to get started
                    </MudText>
                </div>
            }

            <MudTextField Label="Enter Place"
                          @bind-Value="cityName"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-4 mb-4"
                          Style="font-size:1.1rem;"
                          FullWidth="true" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mb-4"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.WbSunny"
                       OnClick="GetWeather">
                Get Weather
            </MudButton>

            @if (isLoading)
            {
                <MudProgressCircular Color="Color.Primary"
                                     Indeterminate="true"
                                     Class="mt-4" />
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">
                    @errorMessage
                </MudAlert>
            }

            @if (showWeather && weather != null)
            {
                <WeatherCard Weather="weather"
                             AddFavorite="AddFavorite" />
            }

            @if (forecasts.Count > 0)
            {
                <MudText Typo="Typo.h5" Class="mt-6 mb-4">
                    5-Day Forecast
                </MudText>
            }

            <MudGrid Spacing="3" Justify="Justify.FlexStart">
                @foreach (var item in forecasts)
                {
                    <MudItem xs="6" sm="4" md="4">
                        <ForecastCard Forecast="item" />
                    </MudItem>
                }
            </MudGrid>

            @if (AuthService.IsLoggedIn())
            {
                <MudText Typo="Typo.h5" Class="mt-6 mb-3">
                    Favorite Cities
                </MudText>

                <div class="d-flex flex-wrap gap-2">
                    @foreach (var city in favoriteCities)
                    {
                        <MudChip T="string"
                                 Color="Color.Primary"
                                 Variant="Variant.Filled">
                            <span @onclick='() => LoadCity(city)'
                                  style="cursor:pointer">
                                ⭐ @city
                            </span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           OnClick='() => RemoveFavorite(city)' />
                        </MudChip>
                    }
                </div>
            }

            @if (searchHistory.Count > 0)
            {
                <MudText Typo="Typo.h6" Class="mt-6 mb-2">
                    Recent Searches
                </MudText>
            }

            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var city in searchHistory)
                {
                    <MudChip T="string"
                             Color="Color.Primary"
                             Variant="Variant.Filled"
                             @onclick='() => LoadCity(city)'>
                        @city
                    </MudChip>
                }
            </div>

        </MudPaper>
    </MudContainer>
</div>

@code {

    WeatherModel? weather;
    string cityName = "";
    bool showWeather = false;
    bool isLoading = false;
    string errorMessage = "";
    List<ForecastModel> forecasts = new();
    List<string> searchHistory = new();
    List<string> favoriteCities = new();
    bool isDarkMode => AppLayout?.IsDarkMode ?? false;

    [CascadingParameter]
    public MainLayout? AppLayout { get; set; }

    async Task GetWeather()
    {
        try
        {
            isLoading = true;
            errorMessage = "";

            if (string.IsNullOrWhiteSpace(cityName))
            {
                errorMessage = "Please enter a city name.";
                isLoading = false;
                return;
            }

            weather = await WeatherService.GetWeather(cityName);
            forecasts = await WeatherService.GetForecast(cityName);
            showWeather = true;

            if (!searchHistory.Contains(cityName))
                searchHistory.Insert(0, cityName);

            if (AuthService.IsLoggedIn())
            {
                try
                {
                    var favWeather = await FavoritesService.GetFavoriteWeather();
                    if (!string.IsNullOrEmpty(favWeather))
                    {
                        var matchingForecast = forecasts.FirstOrDefault(f => f.Condition == favWeather);
                        if (matchingForecast != null)
                        {
                            Snackbar.Add(
                                $"{WeatherHelper.GetWeatherIcon(favWeather)} {favWeather} weather expected in {cityName} on {matchingForecast.Date:ddd, MMM dd}!",
                                Severity.Info);
                        }
                    }
                }
                catch { }
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Place not found. Please enter a valid place name.";
            weather = null;
            forecasts.Clear();
            showWeather = false;
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong. Please try again.";
            weather = null;
            forecasts.Clear();
            showWeather = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task LoadCity(string city)
    {
        cityName = city;
        await GetWeather();
    }

    async Task AddFavorite()
    {
        try
        {
            if (!AuthService.IsLoggedIn())
            {
                errorMessage = "Please login to save favorite cities.";
                return;
            }

            if (weather?.City != null && !favoriteCities.Contains(weather.City))
            {
                await FavoritesService.AddFavorite(weather.City);
                favoriteCities.Add(weather.City);
                Snackbar.Add($"{weather.City} added to favorites! ⭐", Severity.Success);
            }
            else if (weather?.City != null && favoriteCities.Contains(weather.City))
            {
                Snackbar.Add($"{weather.City} is already in favorites!", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task RemoveFavorite(string city)
    {
        await FavoritesService.RemoveFavorite(city);
        favoriteCities.Remove(city);
        Snackbar.Add($"{city} removed from favorites.", Severity.Info);
    }

    void HandleLogoutCleanup()
    {
        favoriteCities = new List<string>();
        searchHistory = new List<string>();
        weather = null;
        forecasts = new List<ForecastModel>();
        showWeather = false;
        cityName = "";
        errorMessage = "";
        StateHasChanged();
    }

    public void Dispose()
    {
        if (AppLayout != null)
            AppLayout.OnLogout -= HandleLogoutCleanup;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (AppLayout != null)
                AppLayout.OnLogout += HandleLogoutCleanup;

            await Task.Delay(800);

            if (AuthService.IsLoggedIn() && favoriteCities.Count == 0)
            {
                favoriteCities = await FavoritesService.GetFavorites();
                StateHasChanged();
            }
        }
    }

    string GetPageBackground()
    {
        if (weather == null)
            return isDarkMode
                ? "linear-gradient(180deg, #1a1a2e 0%, #16213e 100%)"
                : "#F0F4F8";

        return weather.Condition switch
        {
            "Clear" => isDarkMode
                ? "linear-gradient(180deg, #1B2735 0%, #2C5364 100%)"
                : "linear-gradient(180deg, #FFF9C4 0%, #FFE082 50%, #FFB300 100%)",

            "Snow" => isDarkMode
                ? "linear-gradient(180deg, #37474F 0%, #546E7A 100%)"
                : "linear-gradient(180deg, #E3F2FD 0%, #FFFFFF 100%)",

            "Mist" => isDarkMode
                ? "linear-gradient(180deg, #263238 0%, #455A64 100%)"
                : "linear-gradient(180deg, #CFD8DC 0%, #90A4AE 100%)",

            "Clouds" => isDarkMode
                ? "linear-gradient(180deg, #2c3e50 0%, #3d5166 100%)"
                : "linear-gradient(180deg, #ECEFF1 0%, #B0BEC5 100%)",

            "Rain" => "linear-gradient(180deg, #1A237E 0%, #1565C0 100%)",

            "Thunderstorm" => "linear-gradient(180deg, #1A0A2E 0%, #4A148C 100%)",

            _ => "#F0F4F8"
        };
    }

}